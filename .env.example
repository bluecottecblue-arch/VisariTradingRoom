# ============================================
# VisariTradingRoom — variabili d'ambiente
# Copia questo file in .env e compila i valori
# ============================================

# --- API Keys richieste ---
ANTHROPIC_API_KEY=sk-ant-...              # Obbligatoria. Da https://console.anthropic.com
POLYGON_API_KEY=...                        # Per dati OHLC. Piano gratuito OK per inizio, Starter per backtest seri.

# --- API Keys opzionali ---
# DUKASCOPY_PATH=/data/dukascopy           # Se hai scaricato dati tick localmente

# --- Database ---
DATABASE_URL=postgresql://sf_user:sf_pass@localhost:5432/strategyforge
REDIS_URL=redis://localhost:6379/0

# --- App config ---
SECRET_KEY=cambia-questa-chiave-in-produzione
STORAGE_PATH=./storage
MAX_BACKTEST_YEARS=10
DEFAULT_INITIAL_CAPITAL=10000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app
ANTHROPIC_MAX_TOKENS_PARSE=4096
ANTHROPIC_MAX_TOKENS_FORMALIZE=4096
ANTHROPIC_MAX_TOKENS_BOTGEN=7168
RESEARCH_SCORE_PAPER_TRADE=0.45
RESEARCH_SCORE_LIMITED_LIVE=0.65
RESEARCH_SCORE_PRODUCTION=0.82
RESEARCH_MAX_LIVE_OVERFIT=0.8
RESEARCH_MIN_LIVE_IMPLEMENTATION=0.6
RESEARCH_MAX_LIVE_RISK_OF_RUIN=0.18
RESEARCH_MIN_LIVE_OOS_TRADES=80

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
APP_GATE_PASSWORD=
NEXT_PUBLIC_ENABLE_AD_SLOTS=false
NEXT_PUBLIC_ENABLE_PREMIUM_REPORTS=false
