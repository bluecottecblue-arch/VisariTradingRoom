# ============================================
# VisariTradingRoom — variabili d'ambiente
# Copia questo file in .env e compila i valori
# ============================================

# --- API Keys richieste ---
ANTHROPIC_API_KEY=sk-ant-...              # Obbligatoria. Da https://console.anthropic.com
POLYGON_API_KEY=...                        # Per dati OHLC. Piano gratuito OK per inizio, Starter per backtest seri.

# --- API Keys opzionali ---
# DUKASCOPY_PATH=/data/dukascopy           # Se hai scaricato dati tick localmente

# --- Database ---
DATABASE_URL=postgresql://sf_user:sf_pass@localhost:5432/strategyforge
REDIS_URL=redis://localhost:6379/0

# --- App config ---
SECRET_KEY=cambia-questa-chiave-in-produzione
STORAGE_PATH=./storage
MAX_BACKTEST_YEARS=10
DEFAULT_INITIAL_CAPITAL=10000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
APP_GATE_PASSWORD=
